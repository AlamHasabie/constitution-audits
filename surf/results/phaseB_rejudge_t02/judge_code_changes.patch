+            # this goes into every record.
+            discarded.append((verdict.error or "unknown")[:60])
+
+        verdict.parse_warnings = [
+            *verdict.parse_warnings,
+            f"exhausted_attempts:{';'.join(discarded)}",
+        ]
+        return verdict
