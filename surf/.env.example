# Copy this file to .env and fill in the values you need.
# .env is gitignored. Never commit real keys.
#
#   cp .env.example .env
#
# Which variables you need depends on the provider prefix you pass to
# --target-model / --judge-model / --query-model:
#
#   anthropic:<model>           -> ANTHROPIC_API_KEY
#   openrouter:<model>          -> OPENROUTER_API_KEY
#   https://host/v1:<model>     -> MODEL_API_KEY     (DeepInfra, OpenAI, Together, ...)
#   vllm:<model>                -> none; HF_TOKEN only if the weights are gated
#
# Resolution lives in surf/core/models.py:_get_default_api_key. Note that any
# provider which is neither "anthropic" nor "openrouter" falls back to
# MODEL_API_KEY, defaulting to the literal string "dummy" when it is unset --
# so a missing key for a custom endpoint surfaces as an auth error from that
# endpoint rather than as a clear "key not set" message.

# Anthropic direct. Needed for anthropic:<model>. This is also the only path
# that gets extended thinking for the judge: judge.py gates thinking on the
# model string literally starting with "anthropic:", so routing Claude through
# openrouter: silently disables it and drops max_tokens from 16384 to 2048.
ANTHROPIC_API_KEY=

# OpenRouter. Needed for openrouter:<model>, which is the default query model.
OPENROUTER_API_KEY=

# Any OpenAI-compatible endpoint addressed by URL, e.g.
#   https://api.deepinfra.com/v1/openai:meta-llama/Meta-Llama-3.1-8B-Instruct
#   https://api.openai.com/v1:gpt-4o
MODEL_API_KEY=

# Optional. NOT required to download the default public attributes dataset
# (seoirsem/CHUNKY-tulu3-SFT-25k-attributes). Read only by
# surf/core/vllm_server.py, to pass through for gated weights, and by
# utils/upload_to_hf.py when uploading your own dataset.
HF_TOKEN=
